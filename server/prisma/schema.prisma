// server/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Lock Prisma version to 4.16.2 by removing ^ in package.json: "prisma": "4.16.2"
}

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  username     String?   @unique
  firstName    String?
  lastName     String?
  phone        String?
  password     String?
  googleId     String?   @unique
  profileImage String?
  role         UserRole  @default(STAFF)
  isVerified   Boolean   @default(false)
  otp          String?
  otpExpires   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  receiptsCreated    Receipt[]          @relation("ReceiptCreatedBy")
  deliveriesCreated  DeliveryOrder[]    @relation("DeliveryCreatedBy")
  transfersCreated   InternalTransfer[] @relation("TransferCreatedBy")
  adjustmentsCreated StockAdjustment[]  @relation("AdjustmentCreatedBy")

  @@index([email])
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

// ============================================
// WAREHOUSE & LOCATION
// ============================================

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  zipCode   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  locations     Location[]
  stock         Stock[]
  receipts      Receipt[]
  deliveries    DeliveryOrder[]
  transfersFrom InternalTransfer[] @relation("TransferFromWarehouse")
  transfersTo   InternalTransfer[] @relation("TransferToWarehouse")
  adjustments   StockAdjustment[]

  @@index([code])
}

model Location {
  id          String       @id @default(cuid())
  name        String
  code        String
  type        LocationType @default(SHELF)
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  stock         Stock[]
  transfersFrom InternalTransfer[] @relation("TransferFromLocation")
  transfersTo   InternalTransfer[] @relation("TransferToLocation")

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

enum LocationType {
  SHELF
  RACK
  ZONE
  BIN
  FLOOR
}

// ============================================
// PRODUCT MANAGEMENT
// ============================================

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  products Product[]

  @@index([parentId])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  sku             String    @unique
  description     String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitOfMeasure   String    @default("Units")
  minStock        Float     @default(0)
  maxStock        Float?
  reorderPoint    Float     @default(0)
  reorderQuantity Float     @default(0)
  unitPrice       Float     @default(0)
  image           String?
  barcode         String?   @unique
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  stock           Stock[]
  receiptItems    ReceiptItem[]
  deliveryItems   DeliveryItem[]
  transferItems   TransferItem[]
  adjustmentItems AdjustmentItem[]
  stockLedger     StockLedger[]

  @@index([sku])
  @@index([categoryId])
  @@index([barcode])
}

// ============================================
// STOCK TRACKING
// ============================================

model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantity    Float     @default(0)
  reserved    Float     @default(0)
  available   Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId, locationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([locationId])
}

model StockLedger {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String
  locationId      String?
  transactionType TransactionType
  referenceType   ReferenceType
  referenceId     String
  quantityBefore  Float
  quantityChange  Float
  quantityAfter   Float
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum TransactionType {
  IN
  OUT
  ADJUST
  TRANSFER
}

enum ReferenceType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
  INITIAL
}

// ============================================
// SUPPLIER MANAGEMENT
// ============================================

model Supplier {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  contactPerson String?
  taxId         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  receipts Receipt[]

  @@index([code])
}

// ============================================
// RECEIPT (INCOMING GOODS)
// ============================================

model Receipt {
  id            String         @id @default(cuid())
  receiptNumber String         @unique
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouseId   String
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  status        DocumentStatus @default(DRAFT)
  scheduledDate DateTime?
  receivedDate  DateTime?
  notes         String?
  createdById   String
  createdBy     User           @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  items ReceiptItem[]

  @@index([receiptNumber])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model ReceiptItem {
  id               String   @id @default(cuid())
  receiptId        String
  receipt          Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOrdered  Float
  quantityReceived Float    @default(0)
  unitPrice        Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([receiptId])
  @@index([productId])
}

// ============================================
// CUSTOMER MANAGEMENT
// ============================================

model Customer {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  contactPerson String?
  taxId         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  deliveries DeliveryOrder[]

  @@index([code])
}

// ============================================
// DELIVERY ORDER (OUTGOING GOODS)
// ============================================

model DeliveryOrder {
  id              String         @id @default(cuid())
  deliveryNumber  String         @unique
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  status          DocumentStatus @default(DRAFT)
  scheduledDate   DateTime?
  deliveredDate   DateTime?
  shippingAddress String?
  notes           String?
  createdById     String
  createdBy       User           @relation("DeliveryCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  items DeliveryItem[]

  @@index([deliveryNumber])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryItem {
  id                String        @id @default(cuid())
  deliveryOrderId   String
  deliveryOrder     DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOrdered   Float
  quantityPicked    Float         @default(0)
  quantityPacked    Float         @default(0)
  quantityDelivered Float         @default(0)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([deliveryOrderId])
  @@index([productId])
}

// ============================================
// INTERNAL TRANSFER
// ============================================

model InternalTransfer {
  id              String         @id @default(cuid())
  transferNumber  String         @unique
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  fromLocationId  String?
  fromLocation    Location?      @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId    String?
  toLocation      Location?      @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  status          DocumentStatus @default(DRAFT)
  scheduledDate   DateTime?
  transferredDate DateTime?
  fromContact     String?
  contactName     String?
  notes           String?
  createdById     String
  createdBy       User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  items TransferItem[]

  @@index([transferNumber])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([createdAt])
}

model TransferItem {
  id                  String           @id @default(cuid())
  transferId          String
  transfer            InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId           String
  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityRequested   Float
  quantityTransferred Float            @default(0)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([transferId])
  @@index([productId])
}

// ============================================
// STOCK ADJUSTMENT
// ============================================

model StockAdjustment {
  id               String           @id @default(cuid())
  adjustmentNumber String           @unique
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  reason           AdjustmentReason @default(OTHER)
  status           DocumentStatus   @default(DRAFT)
  adjustmentDate   DateTime?
  notes            String?
  createdById      String
  createdBy        User             @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  items AdjustmentItem[]

  @@index([adjustmentNumber])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model AdjustmentItem {
  id              String          @id @default(cuid())
  adjustmentId    String
  adjustment      StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  systemQuantity  Float
  countedQuantity Float
  difference      Float
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([adjustmentId])
  @@index([productId])
}

enum AdjustmentReason {
  PHYSICAL_COUNT
  DAMAGED
  EXPIRED
  LOST
  FOUND
  OTHER
}

enum DocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}
